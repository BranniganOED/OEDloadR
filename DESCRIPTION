Package: OEDloadR
Type: Package
Title: Download and Read Oregon Employment Department QualityInfo Data
Version: 0.1.0
Authors@R: c(
    person(
      "Brannigan", "Vogt",
      email = "brannigan.t.vogt@employ.oregon.gov",
